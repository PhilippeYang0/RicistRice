# RicistRice zsh config, deployed to ~/.config/zsh/zshrc. ~/.zshrc itself
# lives outside ~/.config, where deploy.sh can't reach, so it holds only:
#   source ~/.config/zsh/zshrc
# and everything else lives here, in the repo.

# --- oh-my-zsh (plugins only; the prompt is starship's, below) ---------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""
plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)
source "$ZSH/oh-my-zsh.sh"

# Suggestions in the theme's dim grey (ANSI bright black = term8)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

# --- Prompt ------------------------------------------------------------------
# starship's config lives in a folder so deploy.sh can copy it like the others
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
eval "$(starship init zsh)"

# --- Greeting ----------------------------------------------------------------
# fastfetch with the current theme's logo (see ~/.config/ricistrice/bin/fetch.sh)
[[ -o interactive ]] && "$HOME/.config/ricistrice/bin/fetch.sh"

# --- Aliases -----------------------------------------------------------------
# Icons for files/directories using lsd
alias ls='lsd'
alias l='ls -l'
alias la='ls -a'
alias lla='ls -la'
alias lt='ls --tree'
