// RicistRice fastfetch config. Run through ~/.config/ricistrice/bin/fetch.sh,
// which adds the current theme's image logo on top of this (the "small" logo
// below is only the fallback for terminals that can't show images).
// Colours are ANSI names, so they follow the theme's terminal colours.
// Every module and option: `fastfetch --help` and `fastfetch --list-modules`.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" },
    "key": { "width": 10 }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "{#magenta}ﾟ･✿ヾ╲(｡◕‿◕｡)╱✿･ﾟ"
    },
    {
      "type": "title",
      "format": "{#bold_blue}{user-name}{#reset_magenta} ♡ {#bold_cyan}{host-name}"
    },
    {
      "type": "custom",
      "format": "{#bright_black}┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    { "type": "os",       "key": "✿ os" },
    { "type": "kernel",   "key": "✿ kernel" },
    { "type": "wm",       "key": "✿ wm" },
    { "type": "shell",    "key": "✿ shell" },
    { "type": "terminal", "key": "✿ term" },
    { "type": "packages", "key": "✿ pkgs" },
    { "type": "uptime",   "key": "✿ uptime" },
    {
      "type": "custom",
      "format": "{#bright_black}┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈"
    },
    { "type": "cpu",    "key": "❀ cpu", "keyColor": "cyan" },
    { "type": "gpu",    "key": "❀ gpu", "keyColor": "cyan", "hideType": "integrated" },
    { "type": "memory", "key": "❀ memory", "keyColor": "cyan" },
    "break",
    { "type": "colors", "symbol": "circle" }
  ]
}
